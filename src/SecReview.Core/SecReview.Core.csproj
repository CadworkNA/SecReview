<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecReview</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Windows APIs are called through pointers (no runtime marshalling), which keeps the
         calls identical under Native AOT. Unsafe code stays inside Probing/Windows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SecReview ships for x64 only. Some Windows structures (the notification-area icon's)
         are laid out differently per processor type, so their declarations are generated
         for that one. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wording of every check: data, embedded so it cannot go missing at run time.
         WithCulture=false: the build would otherwise read "checks.en.json" as an English
         satellite resource and move it out of this assembly. -->
    <EmbeddedResource Include="Catalogue\*.json" WithCulture="false"
                      LogicalName="SecReview.Catalogue.%(Filename)%(Extension)" />

    <!-- The checks written as data (rules\*.json at the top of the repository). -->
    <EmbeddedResource Include="..\..\rules\*.json" WithCulture="false" Link="Rules\Data\%(Filename)%(Extension)"
                      LogicalName="SecReview.Rules.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(KnownMaliciousListSha256)' != ''">
    <!-- The SHA-256 of the list of known-malicious packages this build ships with
         (build.ps1 -MalwareIndex). Only a file with that hash is ever loaded, which ties the
         unsigned list to the signed programs. Without it the build has no list. -->
    <AssemblyMetadata Include="KnownMaliciousListSha256" Value="$(KnownMaliciousListSha256)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateManifestUrl)' != ''">
    <!-- Where this build looks for updates (build.ps1 -UpdateUrl): the address of latest.json.
         Compiled in so that nothing on a PC can point SecReview at another address. Without
         it the build neither looks for updates nor installs any. -->
    <AssemblyMetadata Include="UpdateManifestUrl" Value="$(UpdateManifestUrl)" />
  </ItemGroup>

  <!-- Who signs SecReview's releases (signing\Publisher.props), for signed builds only
       (build.ps1 -Sign). An update is installed only when its setup program is signed by
       exactly this publisher; a build without it never installs one. -->
  <Import Project="..\..\signing\Publisher.props" Condition="'$(SignedBuild)' == 'true'" />

  <ItemGroup Condition="'$(PublisherSubject)' != ''">
    <AssemblyMetadata Include="PublisherSubject" Value="$(PublisherSubject)" />
    <AssemblyMetadata Include="PublisherIdentityOid" Value="$(PublisherIdentityOid)" />
    <AssemblyMetadata Include="PublisherRootSha256" Value="$(PublisherRootSha256)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecReview.Core.Tests" />
  </ItemGroup>

</Project>
