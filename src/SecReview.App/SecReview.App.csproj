<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinUI needs the Windows SDK projection, so this project names an SDK version. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>SecReview</AssemblyName>
    <RootNamespace>SecReview.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon is drawn by code (SecReview.Tray.IconFile); a test holds the file to it. -->
    <ApplicationIcon Condition="Exists('$(MSBuildThisFileDirectory)..\..\resources\SecReview.ico')">$(MSBuildThisFileDirectory)..\..\resources\SecReview.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The app itself has no unsafe code. The WinRT interop generator needs this switch to
         emit the tables that let WinUI controls use .NET collections; without it a bound list
         fails at run time with "not a supported vector". -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Report every type the generator cannot make usable from WinUI, including built-in ones. -->
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
  </PropertyGroup>

  <!-- Unpackaged (no MSIX) with the Windows App SDK copied next to the exe: an installer can
       simply copy the folder, and nothing has to be installed on the PC first. -->
  <PropertyGroup Label="Windows App SDK">
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Program.Main chooses the role (window or tray) before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Label="Native AOT">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ControlFlowGuard>Guard</ControlFlowGuard>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <!-- Error reporting: the library only. The package's own build steps and analyzer are
         left out: they compile the project folder's path into the program, can link a
         native crash handler (which would send memory dumps) and can run a command-line tool
         that uploads symbols and sources. None of that belongs in a build of SecReview. -->
    <PackageReference Include="Sentry" ExcludeAssets="build;buildTransitive;analyzers" />
  </ItemGroup>

  <!-- The exclusion above does not keep the package's code generator from the compiler, so it
       is taken out here. It writes every build property into the program, the project folder
       among them. scripts\check-stage.ps1 fails the build if that folder shows up in what ships. -->
  <Target Name="LeaveOutErrorReportingGenerator" BeforeTargets="XamlPreCompile;CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Sentry'" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(ErrorReportAddress)' != ''">
    <!-- Where errors of SecReview itself are reported (build.ps1 -ErrorReportAddress). Only an
         official build has one; without it nothing is ever sent. In the app only: the
         command-line helper has no use for it and does not carry it. -->
    <AssemblyMetadata Include="ErrorReportAddress" Value="$(ErrorReportAddress)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The program names its symbol file without the folder it was built in. -->
    <LinkerArg Include="/PDBALTPATH:SecReview.pdb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecReview.Core\SecReview.Core.csproj" />
  </ItemGroup>

</Project>
