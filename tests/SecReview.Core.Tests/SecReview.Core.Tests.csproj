<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecReview.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- MSTest on Microsoft.Testing.Platform: the test project is its own runner. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <!-- The notification-click test calls SecReview through Windows' COM, as Windows does,
         with the same pointer declarations the app uses. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.Analyzers" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecReview.Core\SecReview.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon file, for the test that holds it to what the code draws. -->
    <EmbeddedResource Include="..\..\resources\SecReview.ico" LogicalName="SecReview.ico" Condition="Exists('..\..\resources\SecReview.ico')" />
    <!-- The setup script, for the test that holds its notification registration to the code's. -->
    <EmbeddedResource Include="..\..\installer\SecReview.iss" LogicalName="SecReview.iss" />
  </ItemGroup>

</Project>
