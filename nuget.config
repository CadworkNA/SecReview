<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One source. New versions are not picked automatically for 7 days (floating versions fail
       restore; plain restore of a pinned version is not gated, the lock files cover that). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" minPublishAgeHours="168" />
  </packageSources>
  <minPublishAgeExceptions />

  <!-- Allow-list: a package id outside these patterns fails restore. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="MSTest.*" />
      <package pattern="runtime.*" />
    </packageSource>
  </packageSourceMapping>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <!-- Every package must carry nuget.org's repository signature. When nuget.org rotates its
       certificate (the newest expires 2027-05-18), restore fails with NU3034 until
       `dotnet nuget trust sync nuget.org` refreshes the fingerprints below. -->
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
